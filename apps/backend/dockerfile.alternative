# =============================================================================
# Alternative Dockerfile - More Aggressive Dependency Resolution
# =============================================================================
# Use this if the main dockerfile still has dependency conflicts

FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install with force flag to override conflicts
RUN npm install --legacy-peer-deps --force || npm ci --legacy-peer-deps --force

# Copy source code
COPY . .

# Generate Prisma Client
RUN npx prisma generate

# ── Stage 2: Production ──────────────────────────────────────────────────────
FROM node:20-alpine

# Install wget for healthchecks
RUN apk add --no-cache wget

WORKDIR /app

# Create non-root user for security
RUN addgroup -S app && adduser -S app -G app

# Copy everything from builder (simpler approach)
COPY --from=builder /app ./

# Set environment to production
ENV NODE_ENV=production

# Change ownership to non-root user
RUN chown -R app:app /app

# Switch to non-root user
USER app

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5000/api/health || exit 1

# Start application
CMD ["node", "src/server.js"]
