# =============================================================================
# .env.example — TEMPLATE FOR ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it contains secrets.
# This file (.env.example) IS committed — it documents what vars are needed.
#
# cp .env.example .env
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5001

# ── Databases ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL — get from neon.tech dashboard
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# MongoDB Atlas — get from cloud.mongodb.com
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# ── Cache / Queue ─────────────────────────────────────────────────────────────
# Redis Labs — get from redis.com dashboard
REDIS_URL=redis://default:password@host:port

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRE=7d

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Razorpay (payments) ───────────────────────────────────────────────────────
# Use rzp_test_ keys for testing, rzp_live_ for production
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Sangam Namkeen <orders@yourdomain.com>

# ── CORS ──────────────────────────────────────────────────────────────────────
# Your deployed frontend URL — backend allows requests from here
FRONTEND_URL=https://yourdomain.com

# ── Frontend (build arg for Docker) ──────────────────────────────────────────
# Full URL to your backend API — baked into the React bundle at build time
VITE_API_URL=https://api.yourdomain.com/api

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
